rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff are the accounts carrying the admin security claim (admin ==
    // true). Only someone with full access to the Firebase project can set
    // it (scripts/set-admin-claim.mjs, or Identity Toolkit's
    // accounts:update with customAttributes), so it
    // cannot be gained by signing up. The shop account got it on 28 Sep
    // 2026. Until then an allow-listed, verified email address also counted;
    // that fallback is gone, so a new staff account needs the claim before
    // it can see anything. Keep this function identical in storage.rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /repairs/{repairDoc} {

      // CREATE: Only admins can create repair tickets
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['repairId', 'customerName', 'device', 'issueDescription', 'currentStatus'])
                    && request.resource.data.currentStatus == 'received';

      // READ: staff only, and nothing else reads tickets.
      //
      // The tracking page used to query this collection directly, under
      // "allow list: if request.query.limit <= 1". Rules cannot see a
      // query's filter values, so that rule also passed a query with no
      // filter at all: limit(1) plus startAfter() walked every ticket, one
      // per request, with no code needed, and handed over phone numbers,
      // emails, addresses, unlock codes and signature links. The tracking
      // page now reads its own copy at /tracking/{code}, below.
      allow read: if isAdmin();

      // UPDATE/DELETE: Only admins
      allow update, delete: if isAdmin();
    }

    // Public tracking copies: one per repair, stored under the repair's own
    // code (REP_...) and holding only what the customer's tracking page
    // shows. Published by the intake page and kept in step by the
    // dashboard, both through new-repair/tracking-copy.js.
    //
    // get, never list: a visitor can open the copy for a code they already
    // hold, but cannot ask which codes exist. The key list mirrors FIELDS in
    // tracking-copy.js, and any other key is refused, so contact details or
    // an unlock code cannot be published here by mistake.
    match /tracking/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.repairId == code
                            && request.resource.data.keys().hasOnly([
                                 'repairId', 'device', 'deviceType', 'brand', 'model',
                                 'issueDescription', 'customerName', 'currentStatus',
                                 'dateReceived', 'estimatedCompletion', 'estimatedCost',
                                 'price', 'photos', 'progress'
                               ]);
      allow delete: if isAdmin();
    }

    // Booking requests from the public /book/ page. Visitors cannot write
    // here at all. The page sends each booking to the submitBooking Cloud
    // Function (server/submit-booking/ in this repo), which checks every
    // field, limits how many bookings one visitor and the whole site can
    // send (see /bookingLimits at the end), stores the photos, and writes
    // the booking and the shop's email notice with the admin SDK. The admin
    // SDK does not go through these rules, so nothing here has to let it in.
    //
    // App Check is NOT active on /book/ (see book/index.html), and nothing
    // here relies on it.
    //
    // Staff read, update and delete bookings from the dashboard. Nobody
    // creates one from a browser, staff included: the dashboard only updates
    // bookings, and a job taken in person is a repair ticket, not a booking.
    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin();
    }

    // Customer directory, built by the in-store intake page (/new-repair/).
    // One document per person, so repeat customers link to their own repair
    // history instead of being re-keyed every visit. Holds name, contact
    // details and postal address, so it is admin-only in both directions —
    // there is deliberately no public read path here at all.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Availability settings (working hours, blocked dates). Public read so
    // the booking form can disable unavailable slots; admin write only.
    match /availability/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail collection consumed by the "Trigger Email from Firestore"
    // extension, which sends every document that lands here. The extension
    // uses the Admin SDK and bypasses rules entirely; these rules decide who
    // may queue a message: staff only.
    //
    // The shop's email about each online booking is queued by the
    // submitBooking Cloud Function (server/submit-booking/), with the admin
    // SDK, in the same write as the booking; its wording lives in that
    // function. Visitors cannot queue mail of any kind.
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    // Block everything else. That includes /bookingLimits, the
    // submitBooking function's rate-limit counts (per UK day, and per
    // visitor under a salted hash, never an address): only the function
    // reads and writes them, through the admin SDK, and no browser may
    // read or write them. Also the old /throttle/bookingNotice document,
    // which nothing uses any more.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
