rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access is granted via a custom claim (admin == true) set with the
    // Firebase Admin SDK, with the email allow-list kept as a transitional
    // fallback. Once the custom claim is provisioned on the admin account,
    // remove the email branch so admin status no longer depends on a
    // user-controllable token field.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
            || request.auth.token.email in ['onlinerepairbooking@gmail.com']);
    }

    match /repairs/{repairDoc} {

      // CREATE: Only admins can create repair tickets
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['repairId', 'customerName', 'device', 'issueDescription', 'currentStatus'])
                    && request.resource.data.currentStatus == 'received';

      // READ: Admins can read everything
      allow read: if isAdmin();

      // Public tracking page: anonymous lookup by repairId. Firestore
      // security rules cannot inspect query filter values (request.query
      // only exposes limit, offset, orderBy), so we cannot require the
      // filter be on the repairId field. Rate-limiting is enforced via
      // request.query.limit <= 1 — an attacker has to make one query per
      // doc to enumerate, and the security boundary is the unguessable
      // 128-bit repairId generated in new-repair/index.html.
      allow list: if request.query.limit <= 1;

      // UPDATE/DELETE: Only admins
      allow update, delete: if isAdmin();
    }

    // Booking requests. Creation is NOT open to clients any more: it goes
    // through the submitBooking Cloud Function, which validates the slot
    // against working hours, manual overrides, the live Google Calendar and
    // existing holds before writing anything. A client that could write here
    // directly could hold every slot in the diary, which is exactly what the
    // transactional hold is designed to prevent.
    //
    // Cloud Functions use the Admin SDK and bypass these rules entirely, so
    // locking clients out here costs the booking flow nothing.
    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Per-date availability overrides written by the admin dashboard:
    //   { closed, opens[], blocks[], ignoreCalendarBusy, note }
    // Document id is the date, YYYY-MM-DD. Not public: the booking page no
    // longer computes slots itself, it asks the getSlots function, so there
    // is nothing here a customer needs to read.
    match /availabilityOverrides/{dateKey} {
      allow read, write: if isAdmin();
    }

    // Editable decline reasons (label + emailBody) so the wording of a
    // "sorry, not that day" email can change without a redeploy.
    match /declineReasons/{reasonId} {
      allow read, write: if isAdmin();
    }

    // Slot locks. One document per bookable instant, written only inside the
    // submitBooking transaction — that contention is what makes double
    // booking impossible. Nothing client-side should ever touch these.
    match /slotLocks/{slotKey} {
      allow read, write: if false;
    }

    // Customer directory, built by the in-store intake page (/new-repair/).
    // One document per person, so repeat customers link to their own repair
    // history instead of being re-keyed every visit. Holds name, contact
    // details and postal address, so it is admin-only in both directions —
    // there is deliberately no public read path here at all.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Availability settings (working hours, blocked dates). Public read so
    // the booking form can disable unavailable slots; admin write only.
    match /availability/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail collection consumed by the "Trigger Email from Firestore"
    // extension. The extension uses the Admin SDK and bypasses rules
    // entirely; these rules just keep direct client access locked down.
    // The booking functions (submitBooking, decideBooking) also write here
    // via the Admin SDK, so they are unaffected by these rules.
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
