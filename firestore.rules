rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin access is granted via a custom claim (admin == true) set with the
    // Firebase Admin SDK, with the email allow-list kept as a transitional
    // fallback. Once the custom claim is provisioned on the admin account,
    // delete the email branch entirely — the dashboard's "admin access" line
    // says when that is safe to do.
    //
    // The fallback now also requires a verified address. Firebase can be
    // configured to allow several accounts on one email address, and a token's
    // `email` is whatever the account was registered with, verified or not. On
    // its own the address was therefore enough to become an admin: sign up
    // with it, never confirm it, and the branch below matched. Requiring
    // email_verified closes that, because the real mailbox is needed to
    // confirm the address.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.admin == true
            || (request.auth.token.email in ['onlinerepairbooking@gmail.com']
                && request.auth.token.email_verified == true));
    }

    match /repairs/{repairDoc} {

      // CREATE: Only admins can create repair tickets
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['repairId', 'customerName', 'device', 'issueDescription', 'currentStatus'])
                    && request.resource.data.currentStatus == 'received';

      // READ: staff only, and nothing else reads tickets.
      //
      // The tracking page used to query this collection directly, under
      // "allow list: if request.query.limit <= 1". Rules cannot see a
      // query's filter values, so that rule also passed a query with no
      // filter at all: limit(1) plus startAfter() walked every ticket, one
      // per request, with no code needed, and handed over phone numbers,
      // emails, addresses, unlock codes and signature links. The tracking
      // page now reads its own copy at /tracking/{code}, below.
      allow read: if isAdmin();

      // UPDATE/DELETE: Only admins
      allow update, delete: if isAdmin();
    }

    // Public tracking copies: one per repair, stored under the repair's own
    // code (REP_...) and holding only what the customer's tracking page
    // shows. Published by the intake page and kept in step by the
    // dashboard, both through new-repair/tracking-copy.js.
    //
    // get, never list: a visitor can open the copy for a code they already
    // hold, but cannot ask which codes exist. The key list mirrors FIELDS in
    // tracking-copy.js, and any other key is refused, so contact details or
    // an unlock code cannot be published here by mistake.
    match /tracking/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
                            && request.resource.data.repairId == code
                            && request.resource.data.keys().hasOnly([
                                 'repairId', 'device', 'deviceType', 'brand', 'model',
                                 'issueDescription', 'customerName', 'currentStatus',
                                 'dateReceived', 'estimatedCompletion', 'estimatedCost',
                                 'price', 'photos', 'progress'
                               ]);
      allow delete: if isAdmin();
    }

    // Public booking requests. Anyone can submit one (the page is the
    // public-facing /book/ form), but reads and mutations are admin-only.
    //
    // This is the site's only endpoint that writes without signing in, so the
    // validation below is the whole boundary. App Check is NOT active on
    // /book/ — the page deliberately does not load it (see the comment in
    // book/index.html), so a rule written as though App Check were enforcing
    // anything would be describing a control that is not there.
    //
    // hasOnly is the important line. Listing the fields a booking may carry
    // is not the same as listing the fields it must have: without hasOnly the
    // shape checks all passed while arbitrary extra keys rode along beside
    // them, so a booking could be padded out to Firestore's 1 MB document
    // limit with anything at all.
    match /bookings/{bookingId} {

      function isValidBookingCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly([
               'createdAt', 'status', 'respondedAt', 'linkedRepairId',
               'adminNotes', 'deleted', 'tempId', 'customer', 'device',
               'issue', 'preferredAt', 'photos', 'photoPaths'
             ])
          && d.customer.keys().hasOnly(['name', 'email', 'phone'])
          && d.device.keys().hasOnly(['category', 'brand', 'model'])
          && d.status == 'pending'
          && d.createdAt == request.time
          && d.respondedAt == null
          && d.linkedRepairId == null
          && d.adminNotes == ''
          && d.deleted == false
          && d.tempId is string && d.tempId.matches('BK_[0-9A-F]{32}')
          && d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() < 100
          && d.customer.email is string && d.customer.email.matches('.*@.*\\..*') && d.customer.email.size() < 200
          && d.customer.phone is string && d.customer.phone.size() > 5 && d.customer.phone.size() < 30
          && d.device.category in ['phone', 'laptop', 'console', 'tablet', 'desktop', 'other']
          && d.device.brand is string && d.device.brand.size() < 50
          && d.device.model is string && d.device.model.size() < 100
          && d.issue is string && d.issue.size() > 0 && d.issue.size() < 1000
          && d.preferredAt is timestamp
          // photos is required to be empty: the booking page no longer puts
          // download links in it (it could not read them back anyway —
          // booking photos are admin-read only, by design), and only the
          // paths are kept.
          //
          // photoPaths must be exactly what the booking page writes, in
          // order. Checking only its length let each entry be any size, so a
          // booking could be padded out to Firestore's 1 MB document limit,
          // and the dashboard now loads the waiting bookings on every sign-in.
          && d.photos is list && d.photos.size() == 0
          && d.photoPaths in [
               [],
               ['bookings/' + d.tempId + '/photo-1.jpg'],
               ['bookings/' + d.tempId + '/photo-1.jpg', 'bookings/' + d.tempId + '/photo-2.jpg'],
               ['bookings/' + d.tempId + '/photo-1.jpg', 'bookings/' + d.tempId + '/photo-2.jpg',
                'bookings/' + d.tempId + '/photo-3.jpg']
             ];
      }

      allow create: if isValidBookingCreate();
      allow read, update, delete: if isAdmin();
    }

    // Customer directory, built by the in-store intake page (/new-repair/).
    // One document per person, so repeat customers link to their own repair
    // history instead of being re-keyed every visit. Holds name, contact
    // details and postal address, so it is admin-only in both directions —
    // there is deliberately no public read path here at all.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // Availability settings (working hours, blocked dates). Public read so
    // the booking form can disable unavailable slots; admin write only.
    match /availability/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mail collection consumed by the "Trigger Email from Firestore"
    // extension, which sends every document that lands here. The extension
    // uses the Admin SDK and bypasses rules entirely; these rules decide who
    // may queue a message.
    //
    // (This comment used to mention a Cloud Function that emails the shop
    // when a booking arrives. There is none, which is why online bookings
    // went unseen until the booking page queued its own notice, below.)
    match /mail/{mailId} {
      allow read, write: if isAdmin();

      // The booking page's notice to the shop. Anyone can send a booking, so
      // this is the one place a visitor can queue mail, and it is held to:
      //   - the shop's own inbox only, so the site can never be used to
      //     send mail to anyone else. That is the shop's Gmail: mail is sent
      //     through that account, and a copy sent to hello@onlinefix.uk
      //     came back to it through hello@'s forwarding and Gmail kept it
      //     under Sent, out of the inbox. hello@ is still accepted so that
      //     booking pages loaded before the change keep working;
      //   - exactly one notice per booking, written in the same batch as
      //     that booking: the notice takes the booking's id, which must be
      //     new before the batch and hold a booking with that tempId after
      //     it;
      //   - at most one notice every five minutes across the whole site
      //     (the throttle document below), so a script cannot flood the
      //     inbox or use up the day's sending allowance that customer
      //     emails share. A booking refused its notice is still saved, and
      //     still shows on the dashboard;
      //   - fixed wording: the subject and text must be exactly the
      //     template below, filled in from the booking itself. Nobody can
      //     send the shop an email in the shop's own name that says
      //     whatever they like; the customer's words appear only under
      //     their labels. book/booking.js builds the same template and
      //     the two must be changed together;
      //   - plain text only, with no html, attachments or extra headers
      //     (the extension would fetch an attachment's URL itself);
      //   - Reply-To set to the address on that booking, so replying in the
      //     inbox answers the customer.
      // "reference" is the last six characters of the booking id, which is
      // what the customer is shown. "when" is the drop-off time in UK time,
      // formatted by the booking page and held to that one shape here.
      function bookingNoticeText(b, meta) {
        return 'New booking request from the website booking form.\n\n'
          + 'Reference: ' + meta.reference + '\n'
          + 'Customer: ' + b.customer.name + '\n'
          + 'Email: ' + b.customer.email + '\n'
          + 'Phone: ' + b.customer.phone + '\n'
          + 'Wants to drop off: ' + meta.when + '\n'
          + 'Device type: ' + b.device.category + '\n'
          + 'Brand: ' + b.device.brand + '\n'
          + 'Model: ' + b.device.model + '\n'
          + 'Photos: ' + string(b.photoPaths.size()) + '\n\n'
          + 'What the customer wrote:\n' + b.issue + '\n\n'
          + 'Reply to this email to answer the customer. The booking is on the '
          + 'dashboard under Online Bookings: https://onlinefix.co.uk/admin/';
      }

      function isBookingNotice() {
        let m = request.resource.data;
        let b = getAfter(/databases/$(database)/documents/bookings/$(mailId)).data;
        let throttle = getAfter(/databases/$(database)/documents/throttle/bookingNotice).data;
        return mailId.matches('BK_[0-9A-F]{32}')
          && !exists(/databases/$(database)/documents/bookings/$(mailId))
          && b.tempId == mailId
          && throttle.mailId == mailId
          && b.customer.name.matches('[^\\r\\n]+')
          // Every other field printed on a labelled line must stay on it.
          && b.customer.email.matches('[^\\r\\n]+')
          && b.customer.phone.matches('[^\\r\\n]+')
          && b.device.brand.matches('[^\\r\\n]*')
          && b.device.model.matches('[^\\r\\n]*')
          && m.keys().hasOnly(['to', 'replyTo', 'message', 'meta'])
          && m.to in [['onlinerepairbooking@gmail.com'], ['hello@onlinefix.uk']]
          && m.replyTo == b.customer.email
          && m.meta.keys().hasOnly(['kind', 'bookingId', 'reference', 'when'])
          && m.meta.kind == 'booking-request'
          && m.meta.bookingId == mailId
          && m.meta.reference is string && m.meta.reference.matches('[0-9A-F]{6}')
          && mailId.matches('BK_[0-9A-F]{26}' + m.meta.reference)
          && m.meta.when is string
          && m.meta.when.matches('(Mon|Tues|Wednes|Thurs|Fri|Satur|Sun)day [0-9]{1,2} '
               + '(January|February|March|April|May|June|July|August|September|October|November|December)'
               + ' at [0-9]{2}:[0-9]{2}')
          && m.message.keys().hasOnly(['subject', 'text'])
          && m.message.subject == 'Booking request ' + m.meta.reference + ': '
               + b.customer.name + ', ' + m.meta.when
          && m.message.text == bookingNoticeText(b, m.meta);
      }

      allow create: if isBookingNotice();
    }

    // The booking notice throttle: one document holding when the last
    // notice went. Written in the same batch as each notice (see /mail),
    // and refused until five minutes have passed since the one before.
    // Nobody reads it but the rules.
    match /throttle/bookingNotice {
      allow create, update: if request.resource.data.keys().hasOnly(['at', 'mailId'])
        && request.resource.data.at == request.time
        && request.resource.data.mailId is string
        && !exists(/databases/$(database)/documents/mail/$(request.resource.data.mailId))
        && existsAfter(/databases/$(database)/documents/mail/$(request.resource.data.mailId))
        && (resource == null || request.time > resource.data.at + duration.value(5, 'm'));
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
