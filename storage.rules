rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff are the accounts carrying the admin security claim (admin ==
    // true). Only someone with full access to the Firebase project can set
    // it (scripts/set-admin-claim.mjs, or Identity Toolkit's
    // accounts:update with customAttributes), so it
    // cannot be gained by signing up. The shop account got it on 28 Sep
    // 2026. Until then an allow-listed, verified email address also counted;
    // that fallback is gone, so a new staff account needs the claim before
    // it can see anything. Keep this function identical in firestore.rules.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Repair photos
    match /repairs/{repairId}/{allPaths=**} {
      // Only admin-claim users can upload. Both /admin/ and /new-repair/
      // are admin tools; customers never write here.
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');

      // Anyone can open a photo from its link, which the tracking page
      // needs. Listing is staff only: "read" covers listing too, and a public
      // list of repairs/ handed out every job's code as a folder name, which
      // is all it takes to open that job's tracking copy.
      allow get: if true;
      allow list: if isAdmin();
    }

    // Booking photos from the public /book/ page. Visitors cannot upload
    // here: the page sends its photos to the submitBooking Cloud Function
    // (server/submit-booking/), which checks each is a JPEG under 5 MB and
    // stores it as bookings/<booking id>/photo-1.jpg to photo-3.jpg with the
    // admin SDK, which does not go through these rules. Staff open and
    // delete them from the dashboard; nobody else can read or list them.
    match /bookings/{tempId}/{filename} {
      allow read, delete: if isAdmin();
    }

    // Signed drop-off agreements from the in-store intake page.
    //
    // Deliberately NOT stored under /repairs/{id}/, which is public-read so
    // the tracking page can show device photos. A customer's signature is
    // personal data and must never be reachable by URL alone, so it lives on
    // its own path that only signed-in admins can read.
    match /consents/{repairId}/{allPaths=**} {
      allow write: if isAdmin()
                   && request.resource.size < 2 * 1024 * 1024   // 2MB max
                   && request.resource.contentType.matches('image/.*');

      allow read: if isAdmin();
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
